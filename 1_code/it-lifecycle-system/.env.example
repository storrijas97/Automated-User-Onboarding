NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_strong_secret

# MySQL (app database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=it_lifecycle
DB_USER=root
DB_PASSWORD=

# OrangeHRM
ORANGEHRM_BASE_URL=http://<orangehrm-host>
ORANGEHRM_CLIENT_ID=
ORANGEHRM_CLIENT_SECRET=
ORANGEHRM_DB_HOST=<orangehrm-host>
ORANGEHRM_DB_USER=orange
ORANGEHRM_DB_PASS=orange
ORANGEHRM_DB_NAME=orangehrm
ORANGEHRM_POLL_INTERVAL=*/5 * * * *

# Active Directory
AD_URL=ldap://<ad-host>
AD_BASE_DN=DC=company,DC=local
AD_BIND_DN=CN=svc-lifecycle,CN=Users,DC=company,DC=local
AD_BIND_PASSWORD=
AD_USERS_OU=OU=Users,DC=company,DC=local
